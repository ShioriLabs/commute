# Template for secret.properties: copy it to secret.properties (gitignored) and fill it in.
# Nothing here is needed to build. Without all four keys, release builds come out unsigned.

# Release (upload) key. RELEASE_STORE_FILE is relative to this directory (apps/android).
RELEASE_STORE_FILE=
RELEASE_STORE_PASSWORD=
RELEASE_KEY_ALIAS=
RELEASE_KEY_PASSWORD=
