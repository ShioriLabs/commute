<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <!-- The trip's Ongoing Activity on the watch face rides on a notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- "Ingatkan Aku" and "Bangunkan Aku": getting off buzzed as an alarm, through silent mode. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="Commute"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- The trip is started and run on the phone; the watch only follows it. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false" />

        <!-- Shown over the lock: the phone opens it as a trip starts, often on a locked watch in AOD,
             where behind the lock it would draw nothing until unlocked. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- The phone opening the app as a trip starts (WearPaths.WATCH_LINK). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="watch"
                    android:scheme="commute" />
            </intent-filter>
        </activity>

        <!-- The phone's trip changing while the app is closed: keeps the Ongoing Activity up. -->
        <service
            android:name=".TripListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:host="*"
                    android:path="/trip/active"
                    android:scheme="wear" />
                <!-- The saved stations' timetables, for the departures complication. -->
                <data
                    android:host="*"
                    android:pathPrefix="/saved/station/"
                    android:scheme="wear" />
            </intent-filter>
            <!-- The trip's reminder: "Ingatkan Aku"'s buzz, and "Bangunkan Aku" ringing and called off. -->
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" />
                <data android:host="*" />
                <data android:pathPrefix="/trip/wake" />
                <data android:path="/trip/ping" />
            </intent-filter>
        </service>

        <!-- "OTW" on the watch face: the running trip, asked again as the phone's trip changes. -->
        <service
            android:name=".TripComplicationService"
            android:exported="true"
            android:icon="@drawable/ic_launcher_monochrome"
            android:label="@string/complication_otw"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="RANGED_VALUE,SHORT_TEXT,LONG_TEXT" />
            <!-- Pushed, never polled: the trip's changes ask for it. -->
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="0" />
        </service>

        <!-- "Keberangkatan" on the watch face: a saved station's next trains. The timeline it hands
             over moves the slot on by itself; asked again hourly, and as the phone sends boards. -->
        <service
            android:name=".DeparturesComplicationService"
            android:exported="true"
            android:icon="@drawable/ic_launcher_monochrome"
            android:label="@string/complication_departures"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT,LONG_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="3600" />
            <meta-data
                android:name="android.support.wearable.complications.PROVIDER_CONFIG_ACTION"
                android:value="id.shiorilabs.commute.wear.CONFIG_DEPARTURES" />
        </service>

        <!-- Picking the station and direction as a "Keberangkatan" slot is added. -->
        <activity
            android:name=".DeparturesConfigActivity"
            android:exported="true"
            android:label="@string/complication_departures"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="id.shiorilabs.commute.wear.CONFIG_DEPARTURES" />
                <category android:name="android.support.wearable.complications.category.PROVIDER_CONFIG" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- A tap on a departures slot: the station's page on the phone. -->
        <receiver
            android:name=".OpenStationReceiver"
            android:exported="false" />

        <!-- "Udah bangun" on the watch's alarm. Only the app's own pending intent reaches it. -->
        <receiver
            android:name=".AwakeReceiver"
            android:exported="false" />
    </application>

</manifest>
