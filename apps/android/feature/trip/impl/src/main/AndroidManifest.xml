<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Trip mode follows the rider with the screen off, inside a foreground service they started by
         tapping "Mulai perjalanan" and can see in the notification. Location only while it runs:
         there is no ACCESS_BACKGROUND_LOCATION. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- The trip notification as a Live Update on the lock screen and in the status bar. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- "Ingatkan Aku" and "Bangunkan Aku": getting off buzzed as an alarm, through silent mode. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Held at most ten minutes, from "siap-siap" to "turun", so the alert can't be late. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application>
        <service
            android:name=".runtime.TripService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- The clock's ticks while the phone dozes, and the notification's buttons. -->
        <receiver
            android:name=".runtime.TripReceiver"
            android:exported="false" />

        <!-- The watch's buttons on the trip it mirrors, and "Udah bangun" on its alarm. -->
        <service
            android:name=".wear.WearActionService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" />
                <data android:host="*" />
                <data android:path="/trip/action" />
                <data android:path="/trip/wake/ack" />
            </intent-filter>
        </service>

        <!-- The trip log and sensor recordings, shared from Pengaturan → Experimental. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.triplog"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/trip_log_paths" />
        </provider>
    </application>

</manifest>
