<?xml version="1.0" encoding="utf-8"?>
<!--
    What Android may copy off the phone (Android 12+). Everything but the trip log: it holds where the
    rider was, fix by fix, and the privacy policy says it leaves only when the rider shares it.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="trip_log.ndjson" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="trip_log.ndjson" />
    </device-transfer>
</data-extraction-rules>
