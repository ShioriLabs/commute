<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Base.Theme.Commute" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Drawn until the first Compose frame; a hardcoded white here is a flash against the
             app's own background. -->
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- Before Android 12 there is no splash to dress: the window background stands in for it. The
         splash itself is in values-v31. -->
    <style name="Theme.Commute" parent="Base.Theme.Commute" />
</resources>
