# Rules must not overlap. Cloudflare Pages *appends* when two rules match the
# same path, so a /maps/* catch-all plus a per-file override emits a doubled
# `Cache-Control: ...immutable, public, max-age=300` — the override never wins.
# Anything under /maps/ not matched here falls back to the Pages default
# (max-age=0, must-revalidate), which errs toward fresh rather than frozen.
/assets/*
  Cache-Control: public, max-age=2592000, immutable
# Tiles and preview keep stable filenames across builds, so `immutable` here is
# only safe because the renderer requests them with `?v=<manifest.build>` — a
# content hash that changes whenever build:map-tiles regenerates them (see
# createTileSource in app/lib/map-renderer-tile-source.ts). Without that query
# these URLs are frozen at the edge for a year: that is how an 8x8 build ended
# up served as 4x4 pixels at the 16 overlapping coordinates.
#
# manifest.json below stays short-lived and revalidated, so a client picks up
# the new hash within minutes and every tile URL turns over with it.
# Also bump CACHE_NAME in service-worker.js when the tiles change.
/maps/fdtj/tile-*
  Cache-Control: public, max-age=31536000, immutable
/maps/fdtj/preview.webp
  Cache-Control: public, max-age=31536000, immutable
# The map's version pointer — mutable, so it must never be immutable.
/maps/fdtj/manifest.json
  Cache-Control: public, max-age=300, must-revalidate
/index.html
  Cache-Control: public, max-age=600, stale-while-revalidate=86400
