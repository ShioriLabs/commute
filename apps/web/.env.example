# Web app environment variables (Vite / React Router).
# Copy to `.env` and adjust: `cp .env.example .env`
# Only variables prefixed with VITE_ are exposed to the client bundle
# via import.meta.env.

# Base URL of the Commute API, without a trailing slash.
# Used to build request URLs (see app/routes and hooks: import.meta.env.VITE_API_BASE_URL).
# For local dev, point at the API worker (apps/api runs on port 3000).
VITE_API_BASE_URL=http://localhost:3000

# Builds the self-hosted lite bundle for FDTJ instead of the normal app:
# entry point is the map, links off the map/fare surface leave for
# commute.shiorilabs.id, no service worker, no Cloudflare plugin.
#
# Do NOT set this here. `pnpm build:lite` sets it in the child process
# environment for exactly one build (scripts/build-lite.ts). Left set in a
# checked-out .env it would quietly turn an ordinary `pnpm build` — the one that
# deploys to production — into a lite bundle.
# VITE_LITE=1
