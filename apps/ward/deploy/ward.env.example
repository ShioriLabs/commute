# /etc/ward.env (mode 600, owner root). Never commit the filled-in copy.

# SSE endpoint of the relay's TransJakarta feed.
WARD_FEED_URL=
WARD_DATA_DIR=/var/lib/ward

# R2 API token scoped to Object Read & Write on this bucket only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=commute-ward

# Optional: GET on every fully clean checkpoint (e.g. a healthchecks.io check
# with a ~25h period), so a job that stops or keeps failing gets noticed.
WARD_PING_URL=

# Optional overrides
# WARD_KEEP_ARCHIVE_DAYS=30
# WARD_IDLE_MS=45000
# WARD_GAP_MS=90000
